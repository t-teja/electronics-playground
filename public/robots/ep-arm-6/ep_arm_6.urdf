<?xml version="1.0"?>
<!-- EP-Arm-6: MIT teaching arm. DH lengths match src/lib/robot-arm-ik.ts (UR5-class). -->
<robot name="ep_arm_6">

  <material name="cast_iron">
    <color rgba="0.22 0.24 0.28 1"/>
  </material>
  <material name="accent">
    <color rgba="0.24 0.54 0.36 1"/>
  </material>
  <material name="joint_teal">
    <color rgba="0.37 0.92 0.83 1"/>
  </material>
  <material name="tool">
    <color rgba="0.85 0.47 0.23 1"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.075" length="0.08"/></geometry>
      <material name="cast_iron"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry><cylinder radius="0.11" length="0.02"/></geometry>
      <material name="cast_iron"/>
    </visual>
  </link>

  <link name="shoulder_link">
    <visual>
      <origin xyz="0 0 0.06" rpy="0 0 0"/>
      <geometry><cylinder radius="0.055" length="0.12"/></geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0.07 0.06" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.045" length="0.08"/></geometry>
      <material name="joint_teal"/>
    </visual>
  </link>

  <link name="upper_arm_link">
    <visual>
      <origin xyz="0 0 0.2125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.04" length="0.425"/></geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.048" length="0.09"/></geometry>
      <material name="joint_teal"/>
    </visual>
  </link>

  <link name="forearm_link">
    <visual>
      <origin xyz="0 0 0.196125" rpy="0 0 0"/>
      <geometry><cylinder radius="0.032" length="0.39225"/></geometry>
      <material name="accent"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.04" length="0.08"/></geometry>
      <material name="joint_teal"/>
    </visual>
  </link>

  <link name="wrist_1_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.036" length="0.07"/></geometry>
      <material name="joint_teal"/>
    </visual>
    <visual>
      <origin xyz="0 0.02 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.06 0.05"/></geometry>
      <material name="cast_iron"/>
    </visual>
  </link>

  <link name="wrist_2_link">
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.032" length="0.06"/></geometry>
      <material name="joint_teal"/>
    </visual>
  </link>

  <link name="wrist_3_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028" length="0.04"/></geometry>
      <material name="tool"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 0.03"/></geometry>
      <material name="tool"/>
    </visual>
  </link>

  <link name="tool0"/>

  <!-- Joints: origins match ARM_DH in robot-arm-ik.ts -->
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.089159" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0.13585 0" rpy="0 1.57079632679 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="3.15"/>
  </joint>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 -0.1197 0.425" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1416" upper="3.1416" effort="150" velocity="3.15"/>
  </joint>

  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0 0 0.39225" rpy="0 1.57079632679 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>

  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0 0.093 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>

  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="wrist_3_link"/>
    <origin xyz="0 0 0.09465" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="28" velocity="3.2"/>
  </joint>

  <joint name="ee_fixed_joint" type="fixed">
    <parent link="wrist_3_link"/>
    <child link="tool0"/>
    <origin xyz="0 0.0823 0" rpy="0 0 1.57079632679"/>
  </joint>

</robot>
